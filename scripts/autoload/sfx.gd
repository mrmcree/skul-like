extends Node
## Sound-effect player (autoload `Sfx`). Sfx.play("hit_light") from anywhere.
## Sounds live in assets/sfx/<name>.wav (generated by tools/gen_sfx.py).
## Audio is not affected by Engine.time_scale, so hits ring out during hit stop.

const SFX_DIR := "res://assets/sfx/"
const VOICES := 12

var _streams: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var player := AudioStreamPlayer.new()
		add_child(player)
		_players.append(player)


## Play a sound with slight random pitch so repeated hits don't sound robotic.
func play(sound: String, volume_db := 0.0, pitch_jitter := 0.08) -> void:
	var stream := _get_stream(sound)
	if stream == null:
		return
	var player := _players[_next]
	_next = (_next + 1) % VOICES
	player.stream = stream
	player.volume_db = volume_db
	player.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	player.play()


func _get_stream(sound: String) -> AudioStream:
	if not _streams.has(sound):
		var path := SFX_DIR + sound + ".wav"
		if not ResourceLoader.exists(path):
			push_error("Sfx: missing sound '%s'" % path)
			_streams[sound] = null
		else:
			_streams[sound] = load(path)
	return _streams[sound]
